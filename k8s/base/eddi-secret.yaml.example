# EDDI Secrets — TEMPLATE ONLY, DELIBERATELY NOT APPLIED
#
# ⚠️  This file is NOT listed in kustomization.yaml, and its extension is
# ".example" so that a stray `kubectl apply -f k8s/base/` cannot pick it up.
#
# It used to be a live resource in the base. That made every `kubectl apply -k`
# write the placeholder key below over the eddi-secrets Secret:
#   * on a first install the deployment silently ran with a vault key published
#     in this repository, and
#   * on every later re-apply the operator's real key was REPLACED, which makes
#     everything already encrypted with it permanently undecryptable — exactly
#     the outcome the warning at the bottom of this file warns about.
# The Secret is therefore created out-of-band, once, and never reconciled.
#
# The Deployment mounts this Secret as a FILE (projected volume at
# /etc/eddi/secrets, mode 0400) and points QUARKUS_CONFIG_LOCATIONS at it —
# it is deliberately NOT injected with envFrom.secretRef, because environment
# variables are readable from /proc/<pid>/environ by anything in the same PID
# namespace and leak into crash dumps and child processes.
#
# That means the Secret has exactly ONE key — "application-secrets.properties" —
# whose value is a Quarkus properties file. Add further secrets as additional
# lines inside that file (NOT as additional Secret keys), using the Quarkus
# property name rather than the env-var spelling:
#
#   eddi.vault.master-key=...
#   quarkus.datasource.password=...
#   mongodb.connectionstring=...
#
# Create it BEFORE the first `kubectl apply -k`. Until it exists the EDDI pod
# stays in ContainerCreating — it cannot mount a Secret that is not there — and
# starts by itself as soon as the Secret appears. A visible wait, rather than a
# silent boot with the vault inert.
#
# Generate the secret using the helper script:
#   bash k8s/create-secrets.sh
#
# Or create manually:
#   set -euo pipefail
#
#   # mktemp gives an unpredictable name created 0600, so another local user
#   # cannot pre-create the path or point it at a symlink.
#   secrets_file=$(mktemp "${TMPDIR:-/tmp}/eddi-secrets.XXXXXX")
#   trap 'shred -u "$secrets_file" 2>/dev/null || rm -f "$secrets_file"' EXIT
#
#   # Fail closed: an empty key would create a Secret that silently leaves the
#   # vault inert and secrets in plaintext.
#   key=$(openssl rand -base64 24)
#   [ -n "$key" ] || { echo "vault key generation failed" >&2; exit 1; }
#   printf 'eddi.vault.master-key=%s\n' "$key" > "$secrets_file"
#
#   # The Secret key must be named application-secrets.properties — that is the
#   # filename the Deployment mounts. A bare temp path would name it otherwise.
#   #
#   # --dry-run=client | kubectl apply keeps the command idempotent: re-running
#   # it updates the Secret in place instead of failing with AlreadyExists.
#   kubectl create secret generic eddi-secrets \
#     --namespace=eddi \
#     --from-file=application-secrets.properties="$secrets_file" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# The shape that produces:
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: eddi-secrets
#   labels:
#     app.kubernetes.io/name: eddi
#     app.kubernetes.io/component: server
# type: Opaque
# stringData:
#   application-secrets.properties: |
#     # Vault master key — encrypts all stored API keys and secrets.
#     # ⚠️  If you lose this key, encrypted secrets are UNRECOVERABLE.
#     # Generate: openssl rand -base64 24
#     eddi.vault.master-key=<your generated key>
