# PostgreSQL credentials — TEMPLATE ONLY, DELIBERATELY NOT APPLIED
#
# ⚠️  This file is NOT listed in kustomization.yaml, and its extension is
# ".example" so that `kubectl apply -f k8s/overlays/postgres/` cannot pick it up.
# It used to be a live resource carrying eddi/eddi, which
# k8s/examples/postgres-ha layered under `production`: every install got a
# database password published in this repository unless someone remembered to
# edit it first. Create the Secret yourself, once, BEFORE the first apply —
# the postgres and EDDI pods wait for it (CreateContainerConfigError):
#
#   set -eu
#   pw=$(openssl rand -hex 24)
#   kubectl create secret generic postgres-secrets -n eddi \
#     --from-literal=POSTGRES_DB=eddi \
#     --from-literal=POSTGRES_USER=eddi \
#     --from-literal=POSTGRES_PASSWORD="$pw" \
#     --from-literal=postgres-secrets.properties="$(printf 'quarkus.datasource.username=eddi\nquarkus.datasource.password=%s\n' "$pw")"
#
# A bare `kubectl create`, not `apply`: it refuses to replace a live Secret, and
# replacing this one on a running install is exactly the lock-out described
# below. An existing install keeps the Secret it already has — `kubectl apply
# -k` does not prune, so dropping this file from the resources deletes nothing.
#
# POSTGRES_PASSWORD is read by the postgres image only during initdb, against an
# empty PGDATA. PGDATA lives on the StatefulSet's volumeClaimTemplate and
# survives every restart, and nothing in these manifests runs an ALTER ROLE — so
# editing the password on a running install rotates EDDI's half of the
# credential while the database keeps the old one. Every datasource connection
# then fails authentication and the readiness probe never passes, with an error
# that points at neither this Secret nor the PVC.
#
# To rotate afterwards, change the database FIRST, then this file:
#   kubectl exec -n eddi statefulset/postgres -- \
#     psql -U eddi -d eddi -c "ALTER ROLE eddi PASSWORD '<new>'"
#   # then update both copies below and re-apply
#
# Two shapes on purpose:
#   * POSTGRES_* keys are consumed by the postgres container itself, which only
#     reads its bootstrap configuration from environment variables. They are
#     injected one by one with secretKeyRef rather than with envFrom: envFrom
#     would also try to turn postgres-secrets.properties into an environment
#     variable, and the kubelet logs an InvalidEnvironmentVariableNames warning
#     event on every pod start because "." and "-" are not legal there.
#   * postgres-secrets.properties is what EDDI consumes. It is mounted as a FILE
#     into the EDDI container (projected volume, mode 0400) and picked up via
#     QUARKUS_CONFIG_LOCATIONS — never injected as env vars, because environ is
#     readable from /proc/<pid>/environ and leaks into crash dumps and child
#     processes.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: eddi
type: Opaque
stringData:
  POSTGRES_DB: "eddi"
  POSTGRES_USER: "eddi"
  POSTGRES_PASSWORD: "<generated — see the header>"
  # Consumed by EDDI as a mounted config file (see the Deployment patch in
  # kustomization.yaml). Keep these in sync with POSTGRES_USER/POSTGRES_PASSWORD.
  postgres-secrets.properties: |
    quarkus.datasource.username=eddi
    quarkus.datasource.password=<the same generated password>
