licenses/** linguist-generated


# Install scripts -- enforce correct line endings per platform
*.sh text eol=lf
*.ps1 text eol=crlf

# Git hooks have no extension, so *.sh above does not reach them. They are LF in
# the repo today only by luck: a CRLF hook is not merely untidy, it fails to
# execute on Linux and macOS ("bad interpreter"), which would silently disarm the
# force-push guard for everyone who activated it.
.githooks/** text eol=lf

# Lockfiles are LF in the index already; pin it so a Windows checkout with
# core.autocrlf cannot churn them. CRLF normalisation at commit time is what made
# a committed chat bundle differ byte-for-byte from a fresh build of the same name.
ui/*/package-lock.json text eol=lf

# Mail fixtures are RFC 5322 messages: CRLF line endings and, in places, 8-bit
# bytes in a declared (or deliberately wrong) charset. Byte-exact, never
# normalised -- a DKIM fixture whose line endings changed no longer verifies.
src/test/resources/mail/** -text

# The bundled Public Suffix List is kept byte for byte as upstream publishes it
# (LF), so its SHA-256 in public_suffix_list.properties stays checkable; see
# scripts/update-public-suffix-list.py.
src/main/resources/mail/public_suffix_list.dat -text
