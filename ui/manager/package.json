{
  "name": "eddi-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ --max-warnings 0",
    "audit:prod": "node scripts/audit-prod.mjs",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs",
    "openapi:refresh": "node scripts/refresh-openapi-operations.mjs",
    "gen:llm-params": "node scripts/gen-llm-parameter-catalog.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:file": "stryker run --mutate",
    "test:e2e": "playwright test --project=ui",
    "test:e2e:ui": "playwright test --project=ui --ui",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:fullstack": "playwright test --project=fullstack",
    "test:e2e:auth": "playwright test --project=auth",
    "test:e2e:all": "playwright test --project=ui --project=integration --project=fullstack",
    "test:all": "vitest run && playwright test --project=ui",
    "infra:up:mongo": "docker compose -f docker-compose.integration.yml up -d --wait",
    "infra:up:postgres": "docker compose -f docker-compose.integration-postgres.yml up -d --wait",
    "realm:test": "node scripts/make-test-realm.mjs",
    "infra:up:keycloak": "npm run realm:test && docker compose -f docker-compose.integration-keycloak.yml up -d --wait",
    "infra:down:mongo": "docker compose -f docker-compose.integration.yml down -v",
    "infra:down:postgres": "docker compose -f docker-compose.integration-postgres.yml down -v",
    "infra:down:keycloak": "docker compose -f docker-compose.integration-keycloak.yml down -v"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "keycloak-js": "^26.2.4",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.21",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "~30.1.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "typed-rest-client": {
      "qs": "^6.16.0"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
