{
  // @eddi/conversation is compiled as part of each app that imports it (it is
  // consumed as source), so it must satisfy the strictest of them: the
  // Manager's noUncheckedIndexedAccess and its ES2020 target.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vitest.config.ts"]
}
