{
  "name": "eddi-workforce",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "budget": "node ../scripts/check-bundle-budget.mjs workforce",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/ --max-warnings 0",
    "typecheck": "tsc -b",
    "i18n:check": "node ../scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=ui",
    "test:e2e:ui": "playwright test --project=ui --ui"
  },
  "dependencies": {
    "@eddi/app-kit": "*",
    "@eddi/conversation": "*",
    "@eddi/core": "*",
    "@eddi/ui": "*",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "^26.4.7",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.21",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "~30.1.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
