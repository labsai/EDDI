{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsBuildInfo",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vite.embed.config.ts", "vitest.config.ts", "scripts/vite-plugin-brand.d.mts"]
}
