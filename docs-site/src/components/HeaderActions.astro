---
// Replaces Starlight's social icons with the right side of the website's header
// (eddi.technology, src/components/Header.astro): a link back to the site, the
// "Get Started" call to action and the GitHub icon — same markup and styles — so the
// docs read as part of the same site. The theme toggle follows (ThemeToggle.astro).
---

<a href="https://eddi.technology/" class="eddi-nav-link">Website</a>
<a href="https://eddi.technology/getting-started/" class="eddi-cta">Get Started</a>
<a href="https://github.com/labsai/EDDI" class="eddi-icon-link" aria-label="GitHub" target="_blank" rel="noopener">
	<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
</a>

<style>
	.eddi-nav-link {
		display: flex;
		align-items: center;
		padding: 0.4375rem 0.625rem;
		color: var(--eddi-text-muted);
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 500;
		border-radius: 0.375rem;
		transition: color 0.15s, background 0.15s;
		white-space: nowrap;
	}

	.eddi-nav-link:hover {
		color: var(--eddi-text);
		background: var(--eddi-surface);
	}

	.eddi-cta {
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.875rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: #111 !important;
		background: linear-gradient(135deg, var(--eddi-accent-400), var(--eddi-accent-600));
		border-radius: 0.375rem;
		text-decoration: none;
		transition: all 0.15s;
		white-space: nowrap;
		box-shadow: 0 0 12px color-mix(in srgb, var(--eddi-accent) 20%, transparent);
	}

	.eddi-cta:hover {
		box-shadow: 0 0 20px color-mix(in srgb, var(--eddi-accent) 40%, transparent);
		transform: translateY(-1px);
	}

	.eddi-icon-link {
		display: flex;
		align-items: center;
		padding: 0.25rem;
		color: var(--eddi-text-muted);
		border-radius: 0.25rem;
		transition: color 0.15s;
	}

	.eddi-icon-link:hover {
		color: var(--eddi-text);
	}
</style>
